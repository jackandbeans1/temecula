/* ── dedupe tag string, preserve order ───────────────────────────────── */
function dedupe(str){
  const seen=new Set();
  return String(str).split(",").map(s=>s.trim()).filter(Boolean).filter(s=>{
    const k=s.toLowerCase(); if(seen.has(k))return false; seen.add(k); return true;
