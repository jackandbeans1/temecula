#tabs{display:flex;gap:5px;margin-left:auto}
#msgs,#gal{flex:1;overflow-y:auto;padding:14px}
#msgs{display:flex;flex-direction:column;gap:9px}
#gal{display:none;flex-wrap:wrap;gap:8px;align-content:flex-start}
